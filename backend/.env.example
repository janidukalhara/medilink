# ============================================================
# Copy this file to .env  (same folder: backend/.env)
# ============================================================

PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.XXXXX.mongodb.net/medilink?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_32_plus_char_random_secret_key
JWT_EXPIRES_IN=7d

# AI service
AI_SERVICE_URL=http://localhost:8000
# Timeout in milliseconds for AI calls (5 min = 300000)
# Increase to 600000 (10 min) if BERT is slow to load on your machine
AI_TIMEOUT_MS=300000

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# Gmail (use App Password, NOT your real Gmail password)
# Guide: myaccount.google.com > Security > 2-Step Verification > App Passwords
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# Cloudinary (free tier at cloud.cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
