# ─────────────────────────────────────────────────────────────
# MediLink AI Service — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# GEMINI API KEY (PRIMARY — enables VLM prescription reading)
# Get your FREE key at: https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day — enough for development + small production
# Without this key, the service falls back to Tesseract OCR (less accurate)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
